# ---- ArcPools configuration ----
# Copy to .env.local for development. Never commit a filled-in copy.

# Local SQLite file used by the collector and the API.
# Switch to an absolute path in production, or point the adapter at Postgres.
DATABASE_FILE=./data/arcpools.db

# ---- Upstream data sources ----
# Optional. Both APIs work keyless, but keyless tiers are rate-limited hard
# (measured: GeckoTerminal ~30 req/min, page > 10 rejected; DexPaprika runs out
# of credits quickly). Free keys raise both limits.
GECKOTERMINAL_API_KEY=
DEXPAPRIKA_API_KEY=

# ---- Collector tuning ----
# Minimum gap between requests to the same host, in ms.
GT_MIN_INTERVAL_MS=2200
DEXPAPRIKA_MIN_INTERVAL_MS=3000
# GeckoTerminal rejects pages above 10 on the keyless tier.
GT_MAX_PAGE=10
# Pages fetched per sync. Each run rotates its start page, so 3 pages per run
# refreshes the full list about every 30 minutes — the cadence the keyless quota
# sustains. Raise it once you configure free API keys.
SYNC_PAGES=3
# How old a pool's own data may get before its row is marked stale.
SYNC_STALE_AFTER_MS=3600000
# Per-pool detail calls per sync (each one buys an exact fee rate).
SYNC_DETAIL_BUDGET=30
# Token metadata lookups per sync (fills in symbols for pools found via DexPaprika).
SYNC_TOKEN_BUDGET=40
# Set to "false" to skip the DexPaprika cross-check pass.
SYNC_CROSS_CHECK=true
# DexPaprika discovery page cap (100 pools per page).
DEXPAPRIKA_MAX_PAGES=4

# ---- HTTP sync endpoint guards ----
# /api/sync refuses to run unless at least one of these is set.
# Vercel Cron sends CRON_SECRET as a Bearer token on GET.
CRON_SECRET=
# Bearer token required by POST /api/sync (used by `npm run sync` in production).
SYNC_TOKEN=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://arcpools.website